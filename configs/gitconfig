[user]
    email = {{USER_EMAIL}}
    name = {{USER_NAME}}

[core]
    editor = nvim
    pager = delta
    excludesfile = ~/.gitignore_global
    autocrlf = input
    quotepath = false

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only --features=interactive

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = TwoDark
    dark = true
    # Tokyo Night Storm colors
    minus-style = "syntax #3f2d3d"
    minus-non-emph-style = "syntax #3f2d3d"
    minus-emph-style = "syntax #763842"
    minus-empty-line-marker-style = "syntax #3f2d3d"
    line-numbers-minus-style = "#914c54"
    plus-style = "syntax #283b4d"
    plus-non-emph-style = "syntax #283b4d"
    plus-emph-style = "syntax #316172"
    plus-empty-line-marker-style = "syntax #283b4d"
    line-numbers-plus-style = "#449dab"
    line-numbers-zero-style = "#3b4261"
    # Additional Tokyo Night styling
    file-style = "#7aa2f7 bold ul"
    file-decoration-style = "#7aa2f7"
    hunk-header-decoration-style = "#7aa2f7 box ul"
    hunk-header-style = "file line-number syntax"

[delta "interactive"]
    keep-plus-minus-markers = false

[merge]
    conflictstyle = diff3
    tool = nvim-diff3

[mergetool]
    prompt = false
    keepBackup = false

[mergetool "nvim-diff3"]
    cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
    colorMoved = default
    algorithm = histogram
    tool = nvimdiff
    indentHeuristic = true

[difftool]
    prompt = false

[difftool "nvimdiff"]
    cmd = nvim -d $LOCAL $REMOTE

[push]
    autoSetupRemote = true
    default = simple
    followTags = true

[pull]
    rebase = true
    ff = only

[fetch]
    prune = true
    pruneTags = true

[branch]
    autoSetupRebase = always
    autoSetupRemote = true
    sort = -committerdate

[rebase]
    autostash = true
    updateRefs = true
    autoSquash = true
    abbreviateCommands = true

[rerere]
    enabled = true
    autoupdate = true

[help]
    autocorrect = 20

[color]
    ui = auto
    
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = 11
    frag = magenta bold
    commit = yellow bold
    old = red bold
    new = green bold
    whitespace = red reverse

[color "status"]
    added = green
    changed = yellow
    untracked = cyan

[alias]
    # Basic shortcuts
    co = checkout
    br = branch
    ci = commit
    st = status -sb
    cp = cherry-pick
    cl = clone
    
    # Status and info
    s = status -sb
    info = ! "git remote -v && git branch -a"
    
    # Commit helpers
    cm = commit -m
    ca = commit -am
    amend = commit --amend --no-edit
    amendmsg = commit --amend
    fixup = "!f() { git commit --fixup=$1; }; f"
    wip = !git add -A && git commit -m "WIP [skip ci]"
    unwip = !git log -n 1 | grep -q -c "WIP" && git reset HEAD~1
    savepoint = !git add -A && git commit -m "SAVEPOINT"
    
    # Undo commands
    undo = reset HEAD~1 --mixed
    unstage = reset HEAD --
    uncommit = reset --soft HEAD~1
    
    # Logging
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    last = log -1 HEAD --stat
    
    # Diff helpers
    d = diff
    dc = diff --cached
    
    # Branch management
    b = branch -vv
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n 1 git branch -d"
    
    # Stash commands
    sl = stash list
    sp = stash pop
    
    # Remote operations
    f = fetch --all --prune
    pf = push --force-with-lease
    
    # Rebase helpers
    rb = rebase
    rbc = rebase --continue
    rba = rebase --abort
    
    
    # GitHub helpers (requires gh CLI)
    pr = "!f() { git push -u origin HEAD && gh pr create --web; }; f"
    prs = !gh pr list
    prv = !gh pr view --web
    issues = !gh issue list
    repo = !gh repo view --web
    
    # 🔥 POWERFUL ADDITIONS 🔥
    
    # 1. Safe force push (checks if you're about to destroy someone's work)
    pushf = "!git push --force-with-lease --force-if-includes"
    
    # 2. Interactive rebase from main (most common use case)
    reword = "!git fetch origin && git rebase -i origin/main"
    
    # 3. Show what changed between your branch and main
    review = "!git fetch origin && git log --oneline --reverse origin/main..HEAD"
    
    # 4. Quickly switch to main, pull, and delete merged branches
    sync = "!git checkout main && git pull && git cleanup"
    
    # 5. Show files that changed in your branch (for PR description)
    files = "!git diff --name-only origin/main...HEAD"
    
    # 6. Unstage everything (common when you stage too much)
    unstage-all = reset HEAD
    
    # 7. Show recent branches by date (find that branch you were working on)
    recent = "!git for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short) %(committerdate:relative)' | head -10"
    
    # 8. Quick stash with message (better than default stash)
    save = "!f() { git stash push -m \"${1:-WIP}\"; }; f"
    
    # Worktree helpers
    wt = worktree
    wtl = worktree list
    wtr = worktree remove
    wtab = "!f() { git worktree add \"$1\" -b \"$1\" \"origin/$1\"; }; f"
    
    
    # Aliases to manage aliases
    aliases = config --get-regexp alias
    
    # Conventional commits (if your team uses them)
    feat = "!f() { git commit -m \"feat: $1\"; }; f"
    fix = "!f() { git commit -m \"fix: $1\"; }; f"
    chore = "!f() { git commit -m \"chore: $1\"; }; f"
    test = "!f() { git commit -m \"test: $1\"; }; f"
    docs = "!f() { git commit -m \"docs: $1\"; }; f"
    
    # Better clone for worktrees
    clone-bare = "!sh ~/.local/bin/git-clone-bare-for-worktrees"
    # Quick setup of worktree for PR review
    pr-review = "!f() { git fetch origin pull/$1/head:pr-$1 && git worktree add pr-$1 pr-$1; }; f"

[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

[commit]
    verbose = true
    gpgsign = false
    template = ~/.gitmessage

[status]
    submoduleSummary = true
    showStash = true

[transfer]
    fsckobjects = true

[receive]
    fsckObjects = true

[feature]
    manyFiles = true

[gc]
    writeCommitGraph = true
    
[protocol]
    version = 2

[pack]
    useBitmaps = true

[credential]
    # Platform-specific helper will be set by setup script

[url "git@github.com:"]
    insteadOf = https://github.com/
    
[url "git@gitlab.com:"]
    insteadOf = https://gitlab.com/