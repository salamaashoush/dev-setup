// Only what differs from Zed's defaults; `zed: open default settings` lists
// the rest. Seeded once, not linked: Zed writes machine-specific state such as
// SSH hosts into this file.
{
  "theme": "Tokyo Night Storm",
  "icon_theme": "Catppuccin Macchiato",
  "auto_install_extensions": {
    "tokyo-night": true,
    "catppuccin-icons": true,
    "toml": true,
    "dockerfile": true,
    "html": true,
    "make": true,
    "git-firefly": true
  },

  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_size": 14,
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "autosave": "on_focus_change",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "inlay_hints": {
    "enabled": true
  },

  "terminal": {
    "option_as_meta": true
  },
  "load_direnv": "shell_hook",
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
