{
  // Zed Editor Configuration
  // Tokyo Night Storm theme with productivity optimizations

  // ===========================================
  // Theme & Appearance
  // ===========================================
  "theme": "Tokyo Night Storm",
  "icon_theme": "Catppuccin Macchiato",

  // ===========================================
  // Font Configuration
  // ===========================================
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "buffer_font_family": "CaskaydiaCove Nerd Font",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font", "Cascadia Code"],
  "buffer_font_weight": 400,
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "buffer_line_height": {
    "custom": 1.6
  },

  // ===========================================
  // Editor Settings
  // ===========================================
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "none",
  "preferred_line_length": 100,
  "show_wrap_guides": true,
  "auto_indent": true,
  "auto_indent_on_paste": true,
  "use_autoclose": true,
  "use_auto_surround": true,
  "extend_comment_on_newline": true,
  "linked_edits": true,

  // Line numbers
  "relative_line_numbers": true,
  "current_line_highlight": "gutter",
  "selection_highlight": true,
  "rounded_selection": true,

  // Whitespace
  "show_whitespaces": "selection",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  // Cursor
  "cursor_blink": false,
  "cursor_shape": "block",
  "hide_mouse": "on_typing",

  // Scrolling
  "scroll_sensitivity": 1.0,
  "fast_scroll_sensitivity": 4.0,
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "vertical_scroll_margin": 5,

  // ===========================================
  // Formatting & Save
  // ===========================================
  "format_on_save": "on",
  "autosave": "on_focus_change",

  // ===========================================
  // UI Layout
  // ===========================================
  "tab_bar": {
    "show": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
    "show_close_button": "hover",
    "show_diagnostics": "errors"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": false,
    "code_actions": true
  },
  "gutter": {
    "line_numbers": true,
    "folds": true,
    "runnables": true
  },
  "scrollbar": {
    "show": "auto",
    "cursors": false,
    "git_diff": true,
    "search_results": true,
    "diagnostics": "all"
  },
  "minimap": {
    "show": "never"
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },

  // Panels
  "project_panel": {
    "dock": "left",
    "default_width": 260
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "chat_panel": {
    "dock": "right"
  },

  // Preview tabs
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": true
  },

  // ===========================================
  // Terminal
  // ===========================================
  "terminal": {
    "dock": "bottom",
    "font_size": 14,
    "font_family": "CaskaydiaCove Nerd Font Mono",
    "line_height": "comfortable",
    "blinking": "off",
    "copy_on_select": false,
    "option_as_meta": true,
    "shell": "system",
    "working_directory": "current_project_directory",
    "toolbar": {
      "breadcrumbs": true
    }
  },

  // ===========================================
  // Completions & Suggestions
  // ===========================================
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "completions": {
    "words": "fallback",
    "words_min_length": 3,
    "lsp": true,
    "lsp_insert_mode": "replace"
  },

  // Inlay hints
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 500
  },

  // ===========================================
  // Git Integration
  // ===========================================
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
      "show_commit_summary": true,
      "min_column": 80
    }
  },

  // ===========================================
  // Diagnostics
  // ===========================================
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "max_severity": null
    }
  },

  // ===========================================
  // Search
  // ===========================================
  "search": {
    "whole_word": false,
    "case_sensitive": false,
    "regex": false
  },
  "use_smartcase_search": true,
  "search_wrap": true,
  "seed_search_query_from_cursor": "selection",

  // ===========================================
  // File Management
  // ===========================================
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/target",
    "**/.next",
    "**/.turbo",
    "**/dist",
    "**/build",
    "**/.cache",
    "**/__pycache__",
    "**/.venv",
    "**/venv"
  ],
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/secrets.*"
  ],

  // ===========================================
  // Vim Mode (disabled by default)
  // ===========================================
  "vim_mode": false,
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true
  },

  // ===========================================
  // Language-Specific Settings
  // ===========================================
  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "TSX": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "Rust": {
      "tab_size": 4,
      "formatter": "language_server"
    },
    "Go": {
      "tab_size": 4,
      "hard_tabs": true,
      "formatter": "language_server"
    },
    "Python": {
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"]
        }
      }
    },
    "C++": {
      "tab_size": 4,
      "formatter": "language_server"
    },
    "YAML": {
      "tab_size": 2
    },
    "JSON": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "JSONC": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "Markdown": {
      "tab_size": 2,
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 80
    },
    "HTML": {
      "tab_size": 2,
      "formatter": "prettier"
    },
    "CSS": {
      "tab_size": 2,
      "formatter": "prettier"
    }
  },

  // ===========================================
  // LSP Settings
  // ===========================================
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "inlayHints": {
          "bindingModeHints": {
            "enable": true
          },
          "closureReturnTypeHints": {
            "enable": "always"
          }
        }
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true
        }
      }
    }
  },

  // ===========================================
  // AI Features
  // ===========================================
  "features": {
    "edit_prediction_provider": "zed"
  },
  "show_edit_predictions": true,

  // ===========================================
  // System & Behavior
  // ===========================================
  "confirm_quit": false,
  "restore_on_startup": "last_workspace",
  "base_keymap": "VSCode",
  "multi_cursor_modifier": "alt",
  "auto_update": true,
  "load_direnv": "shell_hook",

  // ===========================================
  // Telemetry (disabled)
  // ===========================================
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // ===========================================
  // Auto-install Extensions
  // Note: Rust, TypeScript, Python, Go, C/C++ are built-in
  // ===========================================
  "auto_install_extensions": {
    // Theme
    "tokyo-night": true,

    // Config files
    "toml": true,
    "yaml": true,

    // Web
    "html": true,
    "make": true,
    "tailwindcss": true,

    // DevOps
    "dockerfile": true,
    "terraform": true,

    // Tools
    "git-firefly": true,
    "ruff": true
  }
}
