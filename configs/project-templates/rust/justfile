# List all available commands
default:
    @just --list

# Run the project
run:
    cargo run

# Run with release optimizations
run-release:
    cargo run --release

# Build the project
build:
    cargo build

# Build with release optimizations
build-release:
    cargo build --release

# Run tests
test:
    cargo test

# Run tests with output
test-verbose:
    cargo test -- --nocapture

# Run benchmarks
bench:
    cargo bench

# Format code
fmt:
    cargo fmt

# Check formatting
fmt-check:
    cargo fmt -- --check

# Run clippy
lint:
    cargo clippy -- -D warnings

# Fix clippy warnings
fix:
    cargo clippy --fix --allow-dirty --allow-staged

# Clean build artifacts
clean:
    cargo clean

# Update dependencies
update:
    cargo update

# Check for outdated dependencies
outdated:
    cargo outdated

# Run all checks (format, lint, test)
check: fmt-check lint test

# Watch for changes and run tests
watch:
    cargo watch -x test

# Generate documentation
doc:
    cargo doc --open

# Install the binary locally
install:
    cargo install --path .