# ===========================================
# zsh system functions on fpath (must run first)
# ===========================================
# Brew/distro zsh bakes the version-pinned functions dir into the default
# fpath, so a `brew upgrade zsh` (or distro update) leaves a running shell
# unable to autoload is-at-least, colors, add-zsh-hook or compinit -- which
# breaks zinit and every plugin. Prepend the stable, non-pinned dirs.
() {
  local d
  for d in \
    /opt/homebrew/share/zsh/functions \
    /usr/local/share/zsh/functions \
    "/usr/share/zsh/${ZSH_VERSION}/functions" \
    /usr/share/zsh/functions; do
    [[ -d $d ]] && fpath=("$d" $fpath)
  done
}
typeset -U fpath

# ===========================================
# Zinit Plugin Manager
# ===========================================

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

if [[ ! -f "$ZINIT_HOME/zinit.zsh" ]]; then
    print -P "%F{33}Installing Zinit...%f"
    command mkdir -p "$(dirname $ZINIT_HOME)"
    command git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" && \
        print -P "%F{34}Zinit installed successfully.%f" || \
        print -P "%F{160}Zinit installation failed.%f"
fi

source "$ZINIT_HOME/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

