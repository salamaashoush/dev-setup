# ===========================================
# zsh system functions on fpath (must run first)
# ===========================================
# Brew/distro zsh bakes the version-pinned functions dir into the default
# fpath, so a `brew upgrade zsh` (or distro update) leaves a running shell
# unable to autoload is-at-least, colors, add-zsh-hook or compinit -- which
# breaks zinit and every plugin. Prepend the stable, non-pinned dirs.
() {
  local d
  for d in \
    /opt/homebrew/share/zsh/functions \
    /usr/local/share/zsh/functions \
    "/usr/share/zsh/${ZSH_VERSION}/functions" \
    /usr/share/zsh/functions; do
    [[ -d $d ]] && fpath=("$d" $fpath)
  done
}
typeset -U fpath

# ===========================================
# Cached tool init
# ===========================================
# brew, mise, starship, zoxide, direnv, fzf and vivid each print a static init
# script. Spawning all of them costs more than the rest of startup combined on
# macOS (brew shellenv alone runs a bash script), so source a cached copy. The
# cache is keyed on the resolved binary's path, inode, size and mtime: an
# upgrade moves the path (mise, Homebrew) or replaces the file (pacman,
# self-update), and either rebuilds it. `rm -rf ~/.cache/zsh` forces a rebuild.
#
# Usage: _cached_source <cache-name> <binary> <command...>
# Everything here is builtins: a $(...) would fork and cost what the cache saves.
zmodload -F zsh/stat b:zstat
_zcache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

_cached_source() {
  local name=$1 bin=$2
  shift 2
  if [[ $bin == /* ]]; then bin=${bin:A}; else bin=${commands[$bin]:A}; fi
  [[ -x $bin ]] || return 1

  local cache="$_zcache_dir/$name.zsh" key want=""
  local -A st
  zstat -H st -- $bin || return 1
  key="$bin $st[inode] $st[size] $st[mtime]"
  [[ -r $cache.key ]] && read -r want < $cache.key
  if [[ ! -s $cache || $want != $key ]]; then
    mkdir -p $_zcache_dir
    "$@" >| $cache 2>/dev/null || { rm -f $cache $cache.key; return 1 }
    print -r -- $key >| $cache.key
  fi
  source $cache
}

# ===========================================
# Zinit Plugin Manager
# ===========================================

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

if [[ ! -f "$ZINIT_HOME/zinit.zsh" ]]; then
    print -P "%F{33}Installing Zinit...%f"
    command mkdir -p "$(dirname $ZINIT_HOME)"
    command git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" && \
        print -P "%F{34}Zinit installed successfully.%f" || \
        print -P "%F{160}Zinit installation failed.%f"
fi

source "$ZINIT_HOME/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

