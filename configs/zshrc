# ===========================================
# Completion System
# ===========================================
# compinit itself runs once via `zicompinit` in the turbo block above (after
# the first prompt). Only completion styling lives here -- zstyles are plain
# settings read by the completion system whenever it loads, so order is fine.
# list-colors is set after vivid below, since it copies LS_COLORS when set.

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # Case insensitive
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}-- %d --%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$_zcache_dir/compcache"

# Compile the dump in the background after it exists, so future starts are fast.
{
    local _zcd="${ZDOTDIR:-$HOME}/.zcompdump"
    if [[ -s "$_zcd" && (! -s "${_zcd}.zwc" || "$_zcd" -nt "${_zcd}.zwc") ]]; then
        zcompile "$_zcd"
    fi
} &!

# ===========================================
# Load Aliases and Functions
# ===========================================

[[ -f "$HOME/.config/shell/aliases.sh" ]] && source "$HOME/.config/shell/aliases.sh"

# ===========================================
# Shell Functions
# ===========================================

# Reload the shell cleanly. Re-sourcing .zshrc is unsafe: zinit and the
# eval-based tool hooks (starship/zoxide/direnv/mise/fzf) assume one-shot init
# and stack state on re-source. A fresh exec is clean and, thanks to the fpath
# guard at the top, instant and error-free.
reload() {
    exec zsh
}

# Delete local branches already merged into main/master/develop.
gprune() {
    git branch --merged | grep -v "\*\|main\|master\|develop" | xargs -n 1 git branch -d
}

# mkdir + cd into it.
mkcd() {
    mkdir -p -- "$1" && cd -- "$1"
}

# Timestamped backup copy: backup foo.conf -> foo.conf.2026-01-31_141530.bak
backup() {
    local ts; ts=$(date +%Y-%m-%d_%H%M%S)
    cp -a -- "$1" "$1.${ts}.bak" && print "backup: $1.${ts}.bak"
}

# Extract any common archive by extension.
extract() {
    [[ -f $1 ]] || { print -u2 "extract: '$1' is not a file"; return 1 }
    case $1 in
        *.tar.bz2|*.tbz2) tar xjf -- "$1" ;;
        *.tar.gz|*.tgz)   tar xzf -- "$1" ;;
        *.tar.xz|*.txz)   tar xJf -- "$1" ;;
        *.tar.zst)        tar --zstd -xf -- "$1" ;;
        *.tar)            tar xf -- "$1" ;;
        *.bz2)            bunzip2 -- "$1" ;;
        *.gz)             gunzip -- "$1" ;;
        *.xz)             unxz -- "$1" ;;
        *.zst)            unzstd -- "$1" ;;
        *.zip)            unzip -- "$1" ;;
        *.rar)            unrar x -- "$1" ;;
        *.7z)             7z x -- "$1" ;;
        *.Z)              uncompress -- "$1" ;;
        *) print -u2 "extract: don't know how to extract '$1'"; return 1 ;;
    esac
}

# fzf-powered widgets (only when fzf is present)
if (( $+commands[fzf] )); then
    # Checkout a git branch (local or remote) via fuzzy picker.
    fco() {
        local branch
        branch=$(git branch --all --color=never | grep -v HEAD \
            | sed 's/^[* ] //;s#^remotes/[^/]*/##' | sort -u \
            | fzf --height 40% --reverse) || return
        git checkout "${branch## }"
    }

    # ripgrep -> fzf -> open match in $EDITOR at the right line.
    frg() {
        local file line
        IFS=: read -r file line _ <<<"$(
            rg --line-number --no-heading --color=always --smart-case "${*:-}" \
                | fzf --ansi --delimiter : \
                      --preview 'bat --color=always --highlight-line {2} {1}' \
                      --preview-window '+{2}/2'
        )" || return
        [[ -n $file ]] && "${EDITOR:-nvim}" "+${line}" "$file"
    }

    # Pick process(es) and kill them (SIGTERM unless a signal is given).
    fkill() {
        local pid
        pid=$(ps -ef | sed 1d | fzf --multi --header='[kill:process]' | awk '{print $2}') || return
        [[ -n $pid ]] && print "$pid" | xargs kill "-${1:-15}"
    }

    # cd into a directory picked by fzf: zoxide's frecent dirs, else fd.
    fcd() {
        local dir
        if (( $+commands[zoxide] )); then
            dir=$(zoxide query -l | fzf --preview 'eza --tree --level=2 --color=always --icons {} 2>/dev/null') || return
        else
            dir=$(fd --type d --hidden --follow --exclude .git 2>/dev/null \
                | fzf --preview 'eza --tree --level=2 --color=always --icons {} 2>/dev/null') || return
        fi
        [[ -n $dir ]] && cd -- "$dir"
    }
fi

# lazygit on ctrl-g (opens, restores prompt cleanly on exit)
if (( $+commands[lazygit] )); then
    _lazygit_widget() { lazygit; zle reset-prompt }
    zle -N _lazygit_widget
    bindkey '^g' _lazygit_widget
fi

# ===========================================
# Tool Initialization
# ===========================================
# These register precmd/preexec/zle hooks; re-running them in the same process
# stacks duplicate hooks. Gate behind a one-shot sentinel so a manual
# `source ~/.zshrc` stays harmless (use `reload` for a real clean restart).
if [[ -z $_TOOL_HOOKS_INIT ]]; then
    # Mise first: activation puts the real install dirs on PATH, so the tools
    # initialised below resolve to binaries rather than shims.
    _mise=mise
    [[ -x "$HOME/.local/bin/mise" ]] && _mise="$HOME/.local/bin/mise"
    _cached_source mise-activate $_mise $_mise activate zsh
    unset _mise

    # Starship prompt. It also sets RPROMPT, which would spawn starship a second
    # time on every prompt; starship.toml has no right_format, so drop it.
    if _cached_source starship starship starship init zsh --print-full-init; then
        unset RPROMPT
    fi

    # Zoxide (smart cd) - use 'z' to jump, 'zi' for interactive; 'cd' untouched
    _cached_source zoxide zoxide zoxide init zsh

    # Direnv
    _cached_source direnv direnv direnv hook zsh

    # FZF - fuzzy finder with integrations
    if _cached_source fzf fzf fzf --zsh; then
        # Tokyo Night Storm, from folke/tokyonight.nvim extras/fzf
        export FZF_DEFAULT_OPTS="
            --height 50%
            --layout=reverse
            --border=rounded
            --info=inline-right
            --highlight-line
            --marker='▶'
            --pointer='▶'
            --prompt='❯ '
            --color=bg+:#2e3c64,bg:#1f2335,gutter:#1f2335,border:#29a4bd
            --color=fg:#c0caf5,hl:#2ac3de,hl+:#2ac3de,query:#c0caf5:regular
            --color=header:#ff9e64,info:#545c7e,separator:#ff9e64,scrollbar:#29a4bd
            --color=marker:#ff007c,pointer:#ff007c,prompt:#2ac3de,spinner:#ff007c
            --bind=ctrl-d:half-page-down,ctrl-u:half-page-up
            --bind=ctrl-y:preview-up,ctrl-e:preview-down
        "

        # Use fd for FZF if available (faster than find)
        if (( $+commands[fd] )); then
            export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git --exclude node_modules --exclude .venv'
            export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
            export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git --exclude node_modules --exclude .venv'
        fi

        # Ctrl+T preview with bat (syntax highlighted)
        if (( $+commands[bat] )); then
            export FZF_CTRL_T_OPTS="
                --preview 'bat --style=numbers --color=always --line-range :500 {} 2>/dev/null || cat {}'
                --preview-window=right:60%:wrap
                --bind='ctrl-/:toggle-preview'
            "
        fi

        # Alt+C preview with eza (directory tree)
        if (( $+commands[eza] )); then
            export FZF_ALT_C_OPTS="
                --preview 'eza --tree --level=2 --color=always --icons {} 2>/dev/null'
                --preview-window=right:50%
            "
        fi

        # Ctrl+R history search with preview; Ctrl+Y copies the command
        _clip='xclip -selection clipboard'
        [[ -n $WAYLAND_DISPLAY ]] && _clip=wl-copy
        [[ "$OSTYPE" == darwin* ]] && _clip=pbcopy
        export FZF_CTRL_R_OPTS="
            --preview 'echo {}'
            --preview-window=down:3:wrap
            --bind='ctrl-y:execute-silent(echo -n {2..} | $_clip)+abort'
        "
        unset _clip
    fi

    # Vivid LS_COLORS (theme from ~/.config/vivid/themes, else a built-in).
    # install.sh drops the cache keys when it updates the theme file.
    _vivid_ls_colors() {
        local colors
        colors=$(vivid generate tokyonight-storm 2>/dev/null || vivid generate molokai) || return
        print -r -- "export LS_COLORS=${(q)colors}"
    }
    _cached_source vivid vivid _vivid_ls_colors
    unfunction _vivid_ls_colors

    typeset -g _TOOL_HOOKS_INIT=1
fi

zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Bun completions
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# ===========================================
# Finalize
# ===========================================

# Keep the hook arrays unique so a manual re-source cannot stack entries.
# (compdef replay is handled by `zicdreplay` in the turbo block above.)
typeset -U precmd_functions preexec_functions chpwd_functions

# Load local, machine-specific overrides (kept out of version control)
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
