# ===========================================
# PATH Configuration
# ===========================================

typeset -U path PATH  # Automatically removes duplicates

# Homebrew lives in /opt/homebrew on Apple Silicon and /usr/local on Intel.
# shellenv also puts brew's zsh completions on fpath. Loaded before the block
# below so mise and user paths still win over brew.
if [[ "$OSTYPE" == darwin* ]]; then
    for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [[ -x $_brew ]] && { _cached_source brew-shellenv $_brew $_brew shellenv; break }
    done
    unset _brew
fi

path=(
    # Mise managed tools (highest priority)
    "$HOME/.local/share/mise/shims"

    # User binaries
    "$HOME/.local/bin"
    "$CARGO_HOME/bin"
    "$BUN_INSTALL/bin"
    "$PNPM_HOME"

    # Development tools
    "$ANDROID_HOME/platform-tools"
    "$ANDROID_HOME/emulator"

    # Keep existing PATH
    $path
)

export PATH

# ===========================================
# Zinit Plugins
# ===========================================

# Essential plugins with turbo mode. `zicompinit; zicdreplay` is the single
# source of compinit + compdef replay for the whole config (runs after the
# first prompt). Do not call compinit / cdreplay again elsewhere.
zinit wait lucid light-mode for \
    atinit"zicompinit; zicdreplay" \
        zdharma-continuum/fast-syntax-highlighting \
    atload"_zsh_autosuggest_start" \
        zsh-users/zsh-autosuggestions \
    blockf atpull'zinit creinstall -q .' \
        zsh-users/zsh-completions \
    OMZP::sudo

# Loaded before mise below, which wraps whatever command_not_found_handler
# exists at activation; a later definition would replace mise's.
zinit snippet OMZP::command-not-found

# Git and docker aliases live in aliases.sh. OMZ's git and docker plugins are
# not loaded: they define ~250 aliases, several of which mean something else
# there (OMZ gst is `git status`, ours is `git stash`).

